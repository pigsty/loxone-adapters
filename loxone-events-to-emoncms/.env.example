# UDP port this container listens on for Loxone's push events.
# Configure a Loxone virtual output/UDP monitor action to send here.
UDP_LISTEN_HOST=0.0.0.0
UDP_LISTEN_PORT=5001

EMONCMS_BASE_URL=https://emoncms.org/input/post
EMONCMS_API_KEY=changeme
EMONCMS_NODE=emontx

# Loxone object -> emoncms field mapping (mount your real file over this path)
MAPPING_FILE=/app/config/field_mapping.yaml

REQUEST_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
