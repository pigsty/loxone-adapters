# UDP port this container listens on for Loxone's push events.
# Configure a Loxone virtual output/UDP monitor action to send here.
UDP_LISTEN_HOST=0.0.0.0
UDP_LISTEN_PORT=5000

INFLUXDB_HOST=influxdb.example.local
INFLUXDB_PORT=8086
INFLUXDB_DATABASE=loxone
INFLUXDB_USERNAME=loxone
INFLUXDB_PASSWORD=changeme

LOG_LEVEL=INFO
