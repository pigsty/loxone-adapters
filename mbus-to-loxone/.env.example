# mbus-bridge container/proxy exposing POST /mbus/get/{device}/{baud}/{address}
MBUS_PROXY_URL=http://raspberrypi.example.local:8080/mbus/get/ttyUSB0/2400/152

# Loxone Miniserver
LOXONE_BASE_URL=http://192.168.1.2
LOXONE_USERNAME=admin
LOXONE_PASSWORD=changeme

# M-Bus DataRecord id -> Loxone virtual input mapping
MAPPING_FILE=/app/config/field_mapping.yaml

POLL_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
