# mbus-bridge container/proxy exposing POST /mbus/get/{device}/{baud}/{address}
MBUS_PROXY_URL=http://raspberrypi.example.local:8080/mbus/get/ttyUSB0/2400/152

# Loxone Miniserver
LOXONE_BASE_URL=http://192.168.1.2
LOXONE_USERNAME=admin
LOXONE_PASSWORD=changeme

# Which M-Bus DataRecord id goes to which Loxone virtual input
FLOW_RECORD_ID=4
FLOW_VI=VI16
FLOW_TEMP_RECORD_ID=5
FLOW_TEMP_VI=VI28
RETURN_TEMP_RECORD_ID=6
RETURN_TEMP_VI=VI27

POLL_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
