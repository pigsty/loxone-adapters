# Loxone Miniserver
LOXONE_BASE_URL=http://192.168.1.2
LOXONE_USERNAME=admin
LOXONE_PASSWORD=changeme

# Open Battery Scheduler meter-readings endpoint
OBS_BASE_URL=https://api.example.openbatteryscheduler.com/api/user/meter-readings
OBS_API_KEY=changeme
# Only needed if this OBS endpoint requires a bearer/auth header in addition
# to the API key.
OBS_AUTH_HEADER=

# Loxone object -> OBS field mapping (mount your real file over this path)
MAPPING_FILE=/app/config/field_mapping.yaml

POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
